# E2E Test Environment Configuration

# Database - the e2e harness's own database (docs/development/local-setup.md). It is
# TRUNCATEd by every run; global-setup.ts refuses any database not ending in _e2e.
# Do NOT point this at mwf_target_test (shared with backend jest suites).
DATABASE_URL=postgresql://mwf_user:mwf_password@127.0.0.1:5432/mwf_target_e2e?connect_timeout=30&pool_timeout=30&connection_limit=20
# Per-role URLs are blank so the API falls back to DATABASE_URL above
# (backend/src/lib/database-urls.ts). Present-but-empty also stops dotenv in the API
# from loading APP_/JOB_ values out of backend/.env, so the API cannot reach mwf_target_dev.
APP_DATABASE_URL=
JOB_DATABASE_URL=
AUTH_DATABASE_URL=
OPS_DATABASE_URL=
DB_IDENTITY_BINDING=off

# API URL for mobile app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3000
APP_BASE_URL=http://localhost:8082

# E2E Testing flags (passed to API server via webServer.env)
E2E_AUTH_BYPASS=true
MOCK_LLM=true
