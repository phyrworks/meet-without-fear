# E2E Test Environment Configuration

# Database - the e2e harness's own database (docs/development/local-setup.md). It is
# TRUNCATEd by every run; global-setup.ts refuses any database not ending in _e2e.
# Do NOT point this at mwf_target_test (shared with backend jest suites).
DATABASE_URL=postgresql://mwf_user:mwf_password@127.0.0.1:5432/mwf_target_e2e?connect_timeout=30&pool_timeout=30&connection_limit=20
# DATABASE_URL is the admin URL: global-setup truncates with it, and the API uses it only for the
# E2E tooling connection (routes/e2e.ts, the auth bypass; lib/prisma getE2EToolingPrisma).
# MIGRATOR_DATABASE_URL deploys the baseline: the database and every object in it are owned by
# mwf_migrator (work-k5fk.10.1; run-baseline.sh --as-migrator), so no runtime role owns anything.
MIGRATOR_DATABASE_URL=postgresql://mwf_migrator:mwf_migrator_dev@127.0.0.1:5432/mwf_target_e2e
# Role URLs, all on mwf_target_e2e, matching the golden driver (backend/src/testing/golden/driver.ts)
# and the local replica. The app logs in as mwf_app and holds only its grants (tables.sql); the job
# logs in as mwf_job, so app.session_set_status and the other job-only definer functions accept
# it; identity binding is on, so identity-bound reads (app.current_user_id(),
# v_empathy_direction_status) behave as in production. AUTH_/OPS_ are blank (present-but-empty
# stops dotenv in the API from loading them out of backend/.env, so the API cannot reach
# mwf_target_dev). global-setup.ts refuses any role URL that names another database.
APP_DATABASE_URL=postgresql://mwf_app:mwf_app_dev@127.0.0.1:5432/mwf_target_e2e?connection_limit=20
JOB_DATABASE_URL=postgresql://mwf_job:mwf_job_dev@127.0.0.1:5432/mwf_target_e2e
AUTH_DATABASE_URL=
OPS_DATABASE_URL=
DB_IDENTITY_BINDING=on

# API URL for mobile app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3000
APP_BASE_URL=http://localhost:8082

# E2E Testing flags (passed to API server via webServer.env)
E2E_AUTH_BYPASS=true
MOCK_LLM=true
