# E2E Test Environment Configuration

# Database - the e2e harness's own database (docs/development/local-setup.md). It is
# TRUNCATEd by every run; global-setup.ts refuses any database not ending in _e2e.
# Do NOT point this at mwf_target_test (shared with backend jest suites).
DATABASE_URL=postgresql://mwf_user:mwf_password@127.0.0.1:5432/mwf_target_e2e?connect_timeout=30&pool_timeout=30&connection_limit=20
# Role URLs, all on mwf_target_e2e, matching the golden driver (backend/src/testing/golden/driver.ts)
# and the local replica. The job logs in as mwf_job, so app.session_set_status and the other
# job-only definer functions accept it; identity binding is on, so identity-bound reads
# (app.current_user_id(), v_empathy_direction_status) behave as in production. APP_/AUTH_/OPS_
# are blank: the app falls back to DATABASE_URL (mwf_app has no table grants on a database it does
# not own); present-but-empty also stops dotenv in the API from loading these keys out of
# backend/.env, so the API cannot reach mwf_target_dev. global-setup.ts refuses any role URL that
# names another database.
APP_DATABASE_URL=
JOB_DATABASE_URL=postgresql://mwf_job:mwf_job_dev@127.0.0.1:5432/mwf_target_e2e
AUTH_DATABASE_URL=
OPS_DATABASE_URL=
DB_IDENTITY_BINDING=on

# API URL for mobile app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3000
APP_BASE_URL=http://localhost:8082

# E2E Testing flags (passed to API server via webServer.env)
E2E_AUTH_BYPASS=true
MOCK_LLM=true
