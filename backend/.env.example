PORT=3000

# =============================================================================
# Database (Required)
# =============================================================================
DATABASE_URL=postgresql://mwf_user:mwf_password@localhost:5432/meet_without_fear
DIRECT_URL=postgresql://mwf_user:mwf_password@localhost:5432/meet_without_fear
SHADOW_DATABASE_URL=postgresql://mwf_user:mwf_password@localhost:5432/meet_without_fear_shadow
# Per-role URLs (Phase 3). Each falls back to DATABASE_URL when unset, and
# DATABASE_URL stays the migration URL. Roles come from infra/aws/roles.sql
# (dev passwords in docs/development/local-setup.md). Only APP_ is used today.
# APP_DATABASE_URL=postgresql://mwf_app:mwf_app_dev@localhost:5432/meet_without_fear
# JOB_DATABASE_URL=postgresql://mwf_job:mwf_job_dev@localhost:5432/meet_without_fear
# OPS_DATABASE_URL=postgresql://mwf_ops:mwf_ops_dev@localhost:5432/meet_without_fear
# AUTH_DATABASE_URL=postgresql://mwf_auth:mwf_auth_dev@localhost:5432/meet_without_fear
# Bind the request's user id to every statement (experimental; default off)
# DB_IDENTITY_BINDING=off

# =============================================================================
# Authentication - Clerk (Required)
# Get keys from: https://dashboard.clerk.com → Your App → API Keys
# =============================================================================
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# =============================================================================
# Realtime - Ably (Required)
# Get key from: https://ably.com/accounts → Your App → API Keys
# =============================================================================
ABLY_API_KEY=xxxxx.xxxxx:xxxxx

# =============================================================================
# Email - Resend (Required)
# Get key from: https://resend.com → API Keys
# =============================================================================
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev

# =============================================================================
# App Configuration
# =============================================================================
# For development, use local website URL:
APP_URL=http://localhost:3001
# For production, use:
# APP_URL=https://meetwithoutfear.com

# =============================================================================
# AI Services - AWS Bedrock (Required for AI features)
# =============================================================================
OPENAI_API_KEY=sk-...
# Create an IAM user with bedrock:InvokeModel permission
# Get credentials from: IAM → Users → Your User → Security credentials → Create access key
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Optional: Override the default model (Claude 3.5 Sonnet v2)
# For Claude 4 models, use an inference profile ARN
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# =============================================================================
# Optional Services
# =============================================================================

# SMS (Twilio) - alternative to email invitations
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

ENABLE_AUDIT_STREAM=false

# =============================================================================
# Neural Monitor Dashboard (Optional)
# =============================================================================
# Secret for dashboard API auth via X-Dashboard-Secret header.
# Local/dev only; do not set this in production because browser bundles can leak it.
# Generate a strong random string: openssl rand -hex 32
# DASHBOARD_API_SECRET=
# Comma-separated list of emails allowed to access the dashboard (optional)
# If set, Clerk-authenticated users must have a matching email
# DASHBOARD_ALLOWED_EMAILS=admin@example.com,dev@example.com
# Comma-separated list of Clerk user IDs allowed to access the dashboard (optional)
# Prefer this in production so access does not depend on custom Clerk token claims.
# DASHBOARD_ALLOWED_USER_IDS=user_...
# URL of the deployed dashboard (used for CORS)
# DASHBOARD_URL=https://monitor.meetwithoutfear.com

ASSEMBLYAI_API_KEY=
