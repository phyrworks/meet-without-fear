generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The backend is CommonJS (tsc module=commonjs, ts-jest); emit to match.
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

// Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts
// (runtime, via @prisma/adapter-pg) since Prisma 7.
datasource db {
  provider = "postgresql"
  // extensions = [vector]
}

// ============================================================================
// Target shape, October 2026 — docs/backend/data-model/schema-target-2026-10.md
//
// 47 tables (spec §1.1–1.8). This file declares everything `prisma migrate
// diff` can see. Everything it cannot see — RLS, policies, triggers, CHECKs,
// the `intensity` domain, views, `app.*` functions, grants, the milestone
// seed — lives in the migration SQL. The SQL-only objects that `prisma db
// pull` CAN see are the two generated columns (inline in their CREATE TABLE
// in backend/scripts/target-shape/tables.sql) and the `sql_`-prefixed partial /
// expression indexes (backend/scripts/target-shape/sql-only.sql).
//
// Rules (spec §5): never declare a partial unique; never give a Prisma index
// a `sql_` name; every relation has an explicit onDelete and
// onUpdate: NoAction; generated columns are declared exactly as `db pull`
// renders them. Gate: backend/scripts/target-shape/check-schema.sh.
// ============================================================================

// ----------------------------------------------------------------------------
// 1.1 Core / session (16)
// ----------------------------------------------------------------------------

model Session {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  status                SessionStatus @default(CREATED)
  topicFrame            String?       @map("topic_frame")
  topicFrameConfirmedAt DateTime?     @map("topic_frame_confirmed_at") @db.Timestamptz(3)
  previousSessionId     String?       @map("previous_session_id") @db.Uuid
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(3)
  /// Written only by app.session_archive / app.session_set_status (work-k5fk.10.12); mwf_app has no UPDATE on it.
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz(3)
  /// The user who archived it (a current participant then); NULL for the retention job.
  archivedByUserId      String?       @map("archived_by_user_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  archivedBy      User?     @relation(fields: [archivedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previousSession Session?  @relation("SessionLineage", fields: [previousSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  nextSessions    Session[] @relation("SessionLineage")

  participants    Participant[]
  invitations     Invitation[]
  sessionKeys     SessionKey[]
  needShares      NeedShare[]
  proposals       Proposal[]
  agreements      Agreement[]
  closure         SessionClosure?
  followUps       FollowUp[]
  brainActivities BrainActivity[]
  livePairs       LiveSessionPair[]

  @@index([previousSessionId])
  @@index([archivedByUserId])
  @@map("session")
}

model Participant {
  sessionId     String    @map("session_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  kind          UserKind  @default(human)
  /// Who brought this participant in (a participant of the same session); NULL for the one initiator (work-k5fk.2).
  addedByUserId String?   @map("added_by_user_id") @db.Uuid
  displayName   String?   @map("display_name")
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User         @relation(fields: [userId, kind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)
  addedBy Participant? @relation("ParticipantAddedBy", fields: [sessionId, addedByUserId], references: [sessionId, userId], onDelete: NoAction, onUpdate: NoAction)

  added                   Participant[]          @relation("ParticipantAddedBy")
  livePairsAsA            LiveSessionPair[]      @relation("LiveSessionPairA")
  livePairsAsB            LiveSessionPair[]      @relation("LiveSessionPairB")
  conversations           Conversation[]
  readState               ConversationReadState?
  sentMessages            Message[]              @relation("MessageSender")
  drafts                  Draft[]                @relation("DraftOwner")
  draftsAbout             Draft[]                @relation("DraftAbout")
  milestones              ParticipantMilestone[]
  aiMemories              AiMemory[]
  moodReadings            MoodReading[]
  regulationEvents        RegulationEvent[]
  invitationsSent         Invitation[]
  participantKeys         ParticipantKey[]
  empathyAttemptsAuthored EmpathyAttempt[]       @relation("EmpathyAttemptAuthor")
  empathyAttemptsAbout    EmpathyAttempt[]       @relation("EmpathyAttemptSubject")
  empathyReviews          EmpathyReview[]
  reconcilerResults       ReconcilerResult[]
  guidanceAuthored        ReconcilerGuidance[]   @relation("GuidanceAuthor")
  guidanceAbout           ReconcilerGuidance[]   @relation("GuidanceSubject")
  shareOffers             ContextShareOffer[]
  consents                Consent[]              @relation("ConsentDecider")
  consentsRequested       Consent[]              @relation("ConsentRequester")
  needs                   Need[]
  needShares              NeedShare[]
  needDispositions        NeedDisposition[]
  proposalsCreated        Proposal[]             @relation("ProposalCreator")
  proposalsRemoved        Proposal[]             @relation("ProposalRemover")
  proposalChoices         ProposalChoice[]
  proposalRevisions       ProposalRevision[]
  agreementParties        AgreementParty[]
  closuresClosed          SessionClosure?
  followUpsOwned          FollowUp[]
  followUpCheckins        FollowUpCheckin[]
  followUpNotes           FollowUpNote[]
  brainActivities         BrainActivity[]
  linkedReflections       Reflection[]
  userMemories            UserMemory[]
  reminders               Reminder[]

  @@id([sessionId, userId])
  @@index([sessionId, addedByUserId])
  @@index([userId, kind])
  @@map("participant")
}

/// The one-live-session-per-pair-of-humans rule as a key (work-k5fk.2): maintained by triggers only (trailer.sql
/// app.t_live_session_pair, app.t_live_session_pair_end); a second live session for the pair fails with 23505.
model LiveSessionPair {
  userA     String @map("user_a") @db.Uuid
  userB     String @map("user_b") @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participantA Participant @relation("LiveSessionPairA", fields: [sessionId, userA], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  participantB Participant @relation("LiveSessionPairB", fields: [sessionId, userB], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userA, userB])
  @@index([sessionId, userA])
  @@index([sessionId, userB])
  @@map("live_session_pair")
}

/// sql_conversation_one_main: UNIQUE (session_id, user_id) WHERE kind = 'MAIN' — sql-only.sql.
model Conversation {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId        String             @map("session_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  kind             ConversationKind   @default(MAIN)
  anchorKind       SubchatAnchor?     @map("anchor_kind")
  anchorProposalId String?            @map("anchor_proposal_id") @db.Uuid
  status           ConversationStatus @default(ACTIVE)
  resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz(3)
  /// work-k5fk.4: the seq the next message takes; written only by app.next_message_seq (t_message_seq).
  nextSeq          Int                @default(1) @map("next_seq")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant    Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  anchorProposal Proposal?   @relation(fields: [anchorProposalId, sessionId], references: [id, sessionId], onDelete: SetNull, onUpdate: NoAction)

  messages Message[]

  @@unique([id, sessionId])
  @@index([anchorProposalId])
  @@index([sessionId, userId, kind, status])
  @@map("conversation")
}

model ConversationReadState {
  sessionId              String    @map("session_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  lastViewedAt           DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  /// work-k5fk.4: the seen message is (lastSeenConversationId, lastSeenSeq), of this read state's session.
  lastSeenConversationId String?   @map("last_seen_conversation_id") @db.Uuid
  lastSeenSeq            Int?      @map("last_seen_seq")
  lastViewedShareTabAt   DateTime? @map("last_viewed_share_tab_at") @db.Timestamptz(3)
  lastActiveAt           DateTime? @map("last_active_at") @db.Timestamptz(3)
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant     Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  /// ON DELETE SET NULL (last_seen_conversation_id, last_seen_seq) in the DDL: session_id is never nulled.
  lastSeenMessage Message?    @relation(fields: [lastSeenConversationId, lastSeenSeq, sessionId], references: [conversationId, seq, sessionId], onDelete: SetNull, onUpdate: NoAction)

  @@id([sessionId, userId])
  @@index([lastSeenConversationId, lastSeenSeq, sessionId])
  @@map("conversation_read_state")
}

/// work-k5fk.4: keyed (conversationId, seq); seq is numbered by the t_message_seq trigger
/// (trailer.sql) — never sent by a writer (no role may INSERT it).
model Message {
  conversationId  String            @map("conversation_id") @db.Uuid
  seq             Int
  sessionId       String            @map("session_id") @db.Uuid
  senderUserId    String?           @map("sender_user_id") @db.Uuid
  role            MessageRole
  kind            MessageKind       @default(CHAT)
  content         String
  dedupeKey       MessageDedupeKey? @map("dedupe_key")
  refiningNeedId  String?           @map("refining_need_id") @db.Uuid
  sourceAttemptId String?           @map("source_attempt_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation      Conversation    @relation(fields: [conversationId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)
  senderParticipant Participant?    @relation("MessageSender", fields: [sessionId, senderUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  /// ON DELETE SET NULL (refining_need_id) / (source_attempt_id) in the DDL: session_id is never nulled.
  refiningNeed      Need?           @relation(fields: [refiningNeedId, sessionId], references: [id, sessionId], onDelete: SetNull, onUpdate: NoAction)
  sourceAttempt     EmpathyAttempt? @relation(fields: [sourceAttemptId, sessionId], references: [id, sessionId], onDelete: SetNull, onUpdate: NoAction)

  readStates ConversationReadState[]

  @@id([conversationId, seq])
  @@unique([conversationId, seq, sessionId])
  @@index([refiningNeedId])
  @@index([sourceAttemptId])
  @@index([sessionId, senderUserId])
  @@map("message")
}

/// sql_draft_one_per_point: UNIQUE (session_id, user_id, kind,
/// coalesce(about_user_id, invitation_id, attempt_id, share_offer_id))
/// is an expression index — sql-only.sql. EMPATHY: exactly one of
/// about_user_id / invitation_id (work-99k2: before the partner joins).
model Draft {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kind         DraftKind
  aboutUserId  String?   @map("about_user_id") @db.Uuid
  attemptId    String?   @map("attempt_id") @db.Uuid
  shareOfferId String?   @map("share_offer_id") @db.Uuid
  invitationId String?   @map("invitation_id") @db.Uuid
  content      String
  readyToShare Boolean   @default(false) @map("ready_to_share")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// work-9309: set by "Edit first" on a pre-join draft; cleared by the next draft write.
  reopenedAt   DateTime? @map("reopened_at") @db.Timestamptz(3)

  participant      Participant        @relation("DraftOwner", fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  aboutParticipant Participant?       @relation("DraftAbout", fields: [sessionId, aboutUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  attempt          EmpathyAttempt?    @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shareOffer       ContextShareOffer? @relation(fields: [shareOfferId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitation       Invitation?        @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attemptPin       EmpathyAttempt?    @relation("DraftAttemptPin", fields: [attemptId, sessionId, userId], references: [id, sessionId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)
  invitationPin    Invitation?        @relation("DraftInvitationPin", fields: [invitationId, sessionId, userId], references: [id, sessionId, invitedByUserId], onDelete: Cascade, onUpdate: NoAction)
  shareOfferPin    ContextShareOffer? @relation("DraftShareOfferPin", fields: [shareOfferId, sessionId, userId], references: [id, sessionId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)

  @@index([attemptId])
  @@index([shareOfferId])
  @@index([invitationId])
  @@index([sessionId, aboutUserId])
  @@map("draft")
}

model Milestone {
  key            String         @id
  ordinal        Int            @unique
  stageLabel     String         @map("stage_label")
  scope          MilestoneScope @default(participant)
  selfAssertable Boolean        @default(false) @map("self_assertable")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reached ParticipantMilestone[]

  @@map("milestone")
}

model ParticipantMilestone {
  sessionId    String   @map("session_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  milestoneKey String   @map("milestone_key")
  reachedAt    DateTime @default(now()) @map("reached_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  milestone   Milestone   @relation(fields: [milestoneKey], references: [key], onDelete: Restrict, onUpdate: NoAction)

  @@id([sessionId, userId, milestoneKey])
  @@index([milestoneKey, reachedAt])
  @@map("participant_milestone")
}

/// sql_ai_memory_one_per_participant: UNIQUE (user_id, session_id, kind) WHERE session_id IS NOT NULL and
/// sql_ai_memory_one_global: UNIQUE (user_id, kind) WHERE session_id IS NULL — sql-only.sql (writers upsert in raw SQL).
model AiMemory {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId        String?      @map("session_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  kind             AiMemoryKind
  doc              Json
  docSchemaVersion Int          @default(1) @map("doc_schema_version") @db.SmallInt
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant? @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("ai_memory")
}

/// intensity is the `intensity` domain (int CHECK 1..10) in the migration SQL.
model MoodReading {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  intensity  Int
  context    String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId, userId, recordedAt])
  @@map("mood_reading")
}

model RegulationEvent {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId       String         @map("session_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  type            RegulationType
  intensityBefore Int?           @map("intensity_before")
  intensityAfter  Int?           @map("intensity_after")
  completedAt     DateTime       @default(now()) @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId, userId, completedAt])
  @@map("regulation_event")
}

model Invitation {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId          String           @map("session_id") @db.Uuid
  invitedByUserId    String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId   String?          @map("accepted_by_user_id") @db.Uuid
  claimedByUserId    String?          @map("claimed_by_user_id") @db.Uuid
  inviteeName        String?          @map("invitee_name")
  status             InvitationStatus @default(PENDING)
  messageConfirmedAt DateTime?        @map("message_confirmed_at") @db.Timestamptz(3)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt         DateTime?        @map("accepted_at") @db.Timestamptz(3)
  declinedAt         DateTime?        @map("declined_at") @db.Timestamptz(3)
  declineReason      String?          @map("decline_reason")
  claimedAt          DateTime?        @map("claimed_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session              Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitedByParticipant Participant @relation(fields: [sessionId, invitedByUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  acceptedByUser       User?       @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  claimedByUser        User?       @relation("InvitationClaimedBy", fields: [claimedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drafts               Draft[]
  draftInvitationPins  Draft[]     @relation("DraftInvitationPin")

  @@unique([id, sessionId])
  @@unique([id, sessionId, invitedByUserId])
  @@index([sessionId])
  @@index([status, expiresAt])
  @@index([acceptedByUserId])
  @@index([claimedByUserId])
  @@index([sessionId, invitedByUserId])
  @@map("invitation")
}

/// sql_session_key_live: UNIQUE (session_id) WHERE destroyed_at IS NULL — sql-only.sql.
model SessionKey {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  keyId       String    @map("key_id")
  wrappedDek  Bytes     @map("wrapped_dek")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId])
  @@map("session_key")
}

/// sql_participant_key_live: UNIQUE (session_id, user_id) WHERE destroyed_at IS NULL — sql-only.sql.
model ParticipantKey {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  keyId       String    @map("key_id")
  wrappedDek  Bytes     @map("wrapped_dek")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId, userId])
  @@map("participant_key")
}

// ----------------------------------------------------------------------------
// 1.2 Empathy and reconciler (5)
// ----------------------------------------------------------------------------

/// sql_attempt_one_live_per_direction: UNIQUE (session_id, author_user_id,
/// subject_user_id) WHERE status NOT IN ('SUPERSEDED','VALIDATED') — sql-only.sql.
model EmpathyAttempt {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId           String         @map("session_id") @db.Uuid
  authorUserId        String         @map("author_user_id") @db.Uuid
  subjectUserId       String         @map("subject_user_id") @db.Uuid
  round               Int            @default(1)
  supersedesAttemptId String?        @map("supersedes_attempt_id") @db.Uuid
  content             String
  status              EmpathyStatus  @default(HELD)
  statusVersion       Int            @default(0) @map("status_version")
  submittedAt         DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  revealedAt          DateTime?      @map("revealed_at") @db.Timestamptz(3)
  deliveryStatus      DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveredAt         DateTime?      @map("delivered_at") @db.Timestamptz(3)
  seenAt              DateTime?      @map("seen_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  authorParticipant  Participant      @relation("EmpathyAttemptAuthor", fields: [sessionId, authorUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant      @relation("EmpathyAttemptSubject", fields: [sessionId, subjectUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  supersedesAttempt  EmpathyAttempt?  @relation("EmpathyAttemptSupersession", fields: [supersedesAttemptId, sessionId, authorUserId, subjectUserId], references: [id, sessionId, authorUserId, subjectUserId], onDelete: SetNull, onUpdate: NoAction)
  supersededBy       EmpathyAttempt[] @relation("EmpathyAttemptSupersession")

  deliveredMessages            Message[]
  drafts                       Draft[]
  reviews                      EmpathyReview[]
  reconcilerResults            ReconcilerResult[]
  shareOffers                  ContextShareOffer[]
  consents                     Consent[]
  consentEmpathyAttemptPins    Consent[]           @relation("ConsentEmpathyAttemptPin")
  contextShareOfferAttemptPins ContextShareOffer[] @relation("ContextShareOfferAttemptPin")
  draftAttemptPins             Draft[]             @relation("DraftAttemptPin")
  empathyReviewAttemptPin      EmpathyReview?      @relation("EmpathyReviewAttemptPin")
  reconcilerResultAttemptPins  ReconcilerResult[]  @relation("ReconcilerResultAttemptPin")

  @@unique([id, sessionId])
  @@unique([id, sessionId, subjectUserId])
  @@unique([id, sessionId, authorUserId, subjectUserId])
  @@unique([sessionId, authorUserId, subjectUserId, round])
  @@index([supersedesAttemptId])
  @@index([sessionId, subjectUserId, revealedAt])
  @@map("empathy_attempt")
}

model EmpathyReview {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId      String    @map("attempt_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  reviewerUserId String    @map("reviewer_user_id") @db.Uuid
  validated      Boolean
  feedback       String?
  feedbackSentAt DateTime? @map("feedback_sent_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt             EmpathyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewerParticipant Participant    @relation(fields: [sessionId, reviewerUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  consents          Consent[]
  consentReviewPins Consent[]      @relation("ConsentReviewPin")
  attemptPin        EmpathyAttempt @relation("EmpathyReviewAttemptPin", fields: [attemptId, sessionId, reviewerUserId], references: [id, sessionId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, sessionId])
  @@unique([attemptId, sessionId, reviewerUserId])
  @@index([sessionId, reviewerUserId])
  @@map("empathy_review")
}

/// sql_result_one_current: UNIQUE (attempt_id) WHERE superseded_at IS NULL — sql-only.sql.
model ReconcilerResult {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId             String            @map("attempt_id") @db.Uuid
  sessionId             String            @map("session_id") @db.Uuid
  authorUserId          String            @map("author_user_id") @db.Uuid
  subjectUserId         String            @map("subject_user_id") @db.Uuid
  iteration             Int               @default(1)
  alignmentScore        Int               @map("alignment_score")
  alignmentSummary      String            @map("alignment_summary")
  gapSummary            String            @map("gap_summary")
  gapSeverity           GapSeverity       @map("gap_severity")
  correctlyIdentified   String[]          @default(dbgenerated("('{}'::text[])::ciphertext_list")) @map("correctly_identified")
  missedFeelings        String[]          @default(dbgenerated("('{}'::text[])::ciphertext_list")) @map("missed_feelings")
  misattributions       String[]          @default(dbgenerated("('{}'::text[])::ciphertext_list"))
  mostImportantGap      String?           @map("most_important_gap")
  recommendedAction     RecommenderAction @map("recommended_action")
  rationale             String
  sharingWouldHelp      Boolean           @map("sharing_would_help")
  suggestedShareFocus   String?           @map("suggested_share_focus")
  suggestedShareContent String?           @map("suggested_share_content")
  suggestedShareReason  String?           @map("suggested_share_reason")
  circuitBreakerTripped Boolean           @default(false) @map("circuit_breaker_tripped")
  supersededAt          DateTime?         @map("superseded_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt            EmpathyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant    @relation(fields: [sessionId, subjectUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  guidance                    ReconcilerGuidance?
  shareOffers                 ContextShareOffer[]
  contextShareOfferResultPins ContextShareOffer[] @relation("ContextShareOfferResultPin")
  reconcilerGuidanceResultPin ReconcilerGuidance? @relation("ReconcilerGuidanceResultPin")
  attemptPin                  EmpathyAttempt      @relation("ReconcilerResultAttemptPin", fields: [attemptId, sessionId, authorUserId, subjectUserId], references: [id, sessionId, authorUserId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, sessionId])
  @@unique([id, sessionId, authorUserId, subjectUserId])
  @@unique([id, attemptId])
  @@unique([attemptId, iteration])
  @@index([sessionId, subjectUserId])
  @@map("reconciler_result")
}

model ReconcilerGuidance {
  resultId      String        @id @map("result_id") @db.Uuid
  sessionId     String        @map("session_id") @db.Uuid
  authorUserId  String        @map("author_user_id") @db.Uuid
  subjectUserId String        @map("subject_user_id") @db.Uuid
  areaHint      GuidanceArea? @map("area_hint")
  guidanceType  GuidanceType? @map("guidance_type")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  result             ReconcilerResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorParticipant  Participant      @relation("GuidanceAuthor", fields: [sessionId, authorUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant      @relation("GuidanceSubject", fields: [sessionId, subjectUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  resultPin          ReconcilerResult @relation("ReconcilerGuidanceResultPin", fields: [resultId, sessionId, authorUserId, subjectUserId], references: [id, sessionId, authorUserId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resultId, sessionId, authorUserId, subjectUserId])
  @@index([sessionId, authorUserId])
  @@index([sessionId, subjectUserId])
  @@map("reconciler_guidance")
}

model ContextShareOffer {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId          String           @map("attempt_id") @db.Uuid
  resultId           String           @map("result_id") @db.Uuid
  sessionId          String           @map("session_id") @db.Uuid
  subjectUserId      String           @map("subject_user_id") @db.Uuid
  iteration          Int              @default(1)
  status             ShareOfferStatus @default(PENDING)
  offerMessage       String?          @map("offer_message")
  suggestedContent   String?          @map("suggested_content")
  suggestedReason    String?          @map("suggested_reason")
  sharedContent      String?          @map("shared_content")
  sharedAt           DateTime?        @map("shared_at") @db.Timestamptz(3)
  declinedAt         DateTime?        @map("declined_at") @db.Timestamptz(3)
  offeredAt          DateTime?        @map("offered_at") @db.Timestamptz(3)
  deliveryStatus     DeliveryStatus   @default(PENDING) @map("delivery_status")
  deliveredAt        DateTime?        @map("delivered_at") @db.Timestamptz(3)
  seenAt             DateTime?        @map("seen_at") @db.Timestamptz(3)
  deliveryNotifiedAt DateTime?        @map("delivery_notified_at") @db.Timestamptz(3)
  seenNotifiedAt     DateTime?        @map("seen_notified_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt            EmpathyAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  result             ReconcilerResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant      @relation(fields: [sessionId, subjectUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  drafts                Draft[]
  consents              Consent[]
  consentShareOfferPins Consent[]        @relation("ConsentShareOfferPin")
  attemptPin            EmpathyAttempt   @relation("ContextShareOfferAttemptPin", fields: [attemptId, sessionId, subjectUserId], references: [id, sessionId, subjectUserId], onDelete: Cascade, onUpdate: NoAction)
  resultPin             ReconcilerResult @relation("ContextShareOfferResultPin", fields: [resultId, attemptId], references: [id, attemptId], onDelete: Cascade, onUpdate: NoAction)
  draftShareOfferPins   Draft[]          @relation("DraftShareOfferPin")

  @@unique([id, sessionId])
  @@unique([id, sessionId, subjectUserId])
  @@unique([attemptId, iteration])
  @@index([resultId])
  @@index([sessionId, subjectUserId, status])
  @@map("context_share_offer")
}

// ----------------------------------------------------------------------------
// 1.3 Consent (1)
// ----------------------------------------------------------------------------

/// target_kind is GENERATED ALWAYS AS (CASE … END) STORED — created inline in
/// backend/scripts/target-shape/tables.sql; declared here exactly as `prisma db pull` renders it.
model Consent {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId         String           @map("session_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  requestedByUserId String?          @map("requested_by_user_id") @db.Uuid
  needId            String?          @map("need_id") @db.Uuid
  empathyAttemptId  String?          @map("empathy_attempt_id") @db.Uuid
  proposalId        String?          @map("proposal_id") @db.Uuid
  shareOfferId      String?          @map("share_offer_id") @db.Uuid
  reviewId          String?          @map("review_id") @db.Uuid
  decision          ConsentDecision?
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz(3)
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  targetKind        ConsentTarget    @default(dbgenerated("\nCASE\n    WHEN (need_id IS NOT NULL) THEN 'NEED'::consent_target\n    WHEN (empathy_attempt_id IS NOT NULL) THEN 'EMPATHY_ATTEMPT'::consent_target\n    WHEN (proposal_id IS NOT NULL) THEN 'PROPOSAL'::consent_target\n    WHEN (share_offer_id IS NOT NULL) THEN 'SHARE_OFFER'::consent_target\n    WHEN (review_id IS NOT NULL) THEN 'REVIEW'::consent_target\n    ELSE NULL::consent_target\nEND")) @map("target_kind")

  participant            Participant        @relation("ConsentDecider", fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  requestedByParticipant Participant?       @relation("ConsentRequester", fields: [sessionId, requestedByUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  need                   Need?              @relation(fields: [needId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empathyAttempt         EmpathyAttempt?    @relation(fields: [empathyAttemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposal               Proposal?          @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shareOffer             ContextShareOffer? @relation(fields: [shareOfferId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  review                 EmpathyReview?     @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empathyAttemptPin      EmpathyAttempt?    @relation("ConsentEmpathyAttemptPin", fields: [empathyAttemptId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)
  needPin                Need?              @relation("ConsentNeedPin", fields: [needId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)
  proposalPin            Proposal?          @relation("ConsentProposalPin", fields: [proposalId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)
  reviewPin              EmpathyReview?     @relation("ConsentReviewPin", fields: [reviewId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)
  shareOfferPin          ContextShareOffer? @relation("ConsentShareOfferPin", fields: [shareOfferId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@index([needId])
  @@index([empathyAttemptId])
  @@index([proposalId])
  @@index([shareOfferId])
  @@index([reviewId])
  @@index([sessionId, requestedByUserId])
  @@index([sessionId, userId, decidedAt])
  @@map("consent")
}

