/// target_kind is GENERATED ALWAYS AS (CASE … END) STORED — created by
/// sql-only.sql; declared here exactly as `prisma db pull` renders it.
model Consent {
  id                       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId            String           @map("participant_id") @db.Uuid
  requestedByParticipantId String?          @map("requested_by_participant_id") @db.Uuid
  needId                   String?          @map("need_id") @db.Uuid
  empathyAttemptId         String?          @map("empathy_attempt_id") @db.Uuid
  proposalId               String?          @map("proposal_id") @db.Uuid
  shareOfferId             String?          @map("share_offer_id") @db.Uuid
  reviewId                 String?          @map("review_id") @db.Uuid
  decision                 ConsentDecision?
  decidedAt                DateTime?        @map("decided_at") @db.Timestamptz(3)
  revokedAt                DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  targetKind               ConsentTarget    @default(dbgenerated("\nCASE\n    WHEN (need_id IS NOT NULL) THEN 'NEED'::consent_target\n    WHEN (empathy_attempt_id IS NOT NULL) THEN 'EMPATHY_ATTEMPT'::consent_target\n    WHEN (proposal_id IS NOT NULL) THEN 'PROPOSAL'::consent_target\n    WHEN (share_offer_id IS NOT NULL) THEN 'SHARE_OFFER'::consent_target\n    WHEN (review_id IS NOT NULL) THEN 'REVIEW'::consent_target\n    ELSE NULL::consent_target\nEND")) @map("target_kind")

  participant            Participant        @relation("ConsentDecider", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestedByParticipant Participant?       @relation("ConsentRequester", fields: [requestedByParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  need                   Need?              @relation(fields: [needId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  empathyAttempt         EmpathyAttempt?    @relation(fields: [empathyAttemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposal               Proposal?          @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shareOffer             ContextShareOffer? @relation(fields: [shareOfferId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  review                 EmpathyReview?     @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([requestedByParticipantId])
  @@index([needId])
  @@index([empathyAttemptId])
  @@index([proposalId])
  @@index([shareOfferId])
  @@index([reviewId])
  @@index([participantId, decidedAt])
  @@map("consent")
}

