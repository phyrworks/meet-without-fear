generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The backend is CommonJS (tsc module=commonjs, ts-jest); emit to match.
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

// Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts
// (runtime, via @prisma/adapter-pg) since Prisma 7.
datasource db {
  provider = "postgresql"
  // extensions = [vector]
}

// ============================================================================
// Target shape, October 2026 — docs/backend/data-model/schema-target-2026-10.md
//
// 47 tables (spec §1.1–1.8). This file declares everything `prisma migrate
// diff` can see. Everything it cannot see — RLS, policies, triggers, CHECKs,
// the `intensity` domain, views, `app.*` functions, grants, the milestone
// seed — lives in the migration SQL. The SQL-only objects that `prisma db
// pull` CAN see (the two generated columns and the `sql_`-prefixed partial /
// expression indexes) are in backend/scripts/target-shape/sql-only.sql.
//
// Rules (spec §5): never declare a partial unique; never give a Prisma index
// a `sql_` name; every relation has an explicit onDelete and
// onUpdate: NoAction; generated columns are declared exactly as `db pull`
// renders them. Gate: backend/scripts/target-shape/check-schema.sh.
// ============================================================================

// ----------------------------------------------------------------------------
// 1.1 Core / session (16)
// ----------------------------------------------------------------------------

model Relationship {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  RelationshipMember[]
  sessions Session[]

  @@map("relationship")
}

model RelationshipMember {
  relationshipId String           @map("relationship_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           RelationshipRole @default(member)
  nickname       String?
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([relationshipId, userId])
  @@index([userId])
  @@map("relationship_member")
}

model Session {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  relationshipId        String        @map("relationship_id") @db.Uuid
  status                SessionStatus @default(CREATED)
  topicFrame            String?       @map("topic_frame")
  topicFrameConfirmedAt DateTime?     @map("topic_frame_confirmed_at") @db.Timestamptz(3)
  previousSessionId     String?       @map("previous_session_id") @db.Uuid
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  relationship    Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  previousSession Session?     @relation("SessionLineage", fields: [previousSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  nextSessions    Session[]    @relation("SessionLineage")

  participants    Participant[]
  invitations     Invitation[]
  sessionKeys     SessionKey[]
  needShares      NeedShare[]
  proposals       Proposal[]
  agreements      Agreement[]
  closure         SessionClosure?
  followUps       FollowUp[]
  userMemories    UserMemory[]
  reflections     Reflection[]
  brainActivities BrainActivity[]

  @@index([relationshipId])
  @@index([previousSessionId])
  @@map("session")
}

model Participant {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String          @map("session_id") @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  kind        ParticipantKind @default(human)
  displayName String?         @map("display_name")
  joinedAt    DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt      DateTime?       @map("left_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  conversations           Conversation[]
  readState               ConversationReadState?
  sentMessages            Message[]              @relation("MessageSender")
  drafts                  Draft[]                @relation("DraftOwner")
  draftsAbout             Draft[]                @relation("DraftAbout")
  milestones              ParticipantMilestone[]
  aiMemories              AiMemory[]
  moodReadings            MoodReading[]
  regulationEvents        RegulationEvent[]
  invitationsSent         Invitation[]
  participantKeys         ParticipantKey[]
  empathyAttemptsAuthored EmpathyAttempt[]       @relation("EmpathyAttemptAuthor")
  empathyAttemptsAbout    EmpathyAttempt[]       @relation("EmpathyAttemptSubject")
  empathyReviews          EmpathyReview[]
  reconcilerResults       ReconcilerResult[]
  guidanceAuthored        ReconcilerGuidance[]   @relation("GuidanceAuthor")
  guidanceAbout           ReconcilerGuidance[]   @relation("GuidanceSubject")
  shareOffers             ContextShareOffer[]
  consents                Consent[]              @relation("ConsentDecider")
  consentsRequested       Consent[]              @relation("ConsentRequester")
  needs                   Need[]
  needShares              NeedShare[]
  needDispositions        NeedDisposition[]
  proposalsCreated        Proposal[]             @relation("ProposalCreator")
  proposalsRemoved        Proposal[]             @relation("ProposalRemover")
  proposalChoices         ProposalChoice[]
  proposalRevisions       ProposalRevision[]
  agreementParties        AgreementParty[]
  closuresClosed          SessionClosure[]
  followUpsOwned          FollowUp[]
  followUpCheckins        FollowUpCheckin[]
  followUpNotes           FollowUpNote[]
  brainActivities         BrainActivity[]

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("participant")
}

/// sql_conversation_one_main: UNIQUE (participant_id) WHERE kind = 'MAIN' — sql-only.sql.
model Conversation {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId    String             @map("participant_id") @db.Uuid
  kind             ConversationKind   @default(MAIN)
  anchorKind       SubchatAnchor?     @map("anchor_kind")
  anchorProposalId String?            @map("anchor_proposal_id") @db.Uuid
  status           ConversationStatus @default(ACTIVE)
  resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  anchorProposal Proposal?   @relation(fields: [anchorProposalId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  messages Message[]

  @@index([participantId, kind, status])
  @@index([anchorProposalId])
  @@map("conversation")
}

model ConversationReadState {
  participantId        String    @id @map("participant_id") @db.Uuid
  lastViewedAt         DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  lastSeenMessageId    String?   @map("last_seen_message_id") @db.Uuid
  lastViewedShareTabAt DateTime? @map("last_viewed_share_tab_at") @db.Timestamptz(3)
  lastActiveAt         DateTime? @map("last_active_at") @db.Timestamptz(3)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lastSeenMessage Message?    @relation(fields: [lastSeenMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([lastSeenMessageId])
  @@map("conversation_read_state")
}

model Message {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId      String      @map("conversation_id") @db.Uuid
  senderParticipantId String?     @map("sender_participant_id") @db.Uuid
  role                MessageRole
  kind                MessageKind @default(CHAT)
  content             String
  contentHash         String?     @map("content_hash") @db.VarChar(64)
  refiningNeedId      String?     @map("refining_need_id") @db.Uuid
  sourceAttemptId     String?     @map("source_attempt_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  senderParticipant Participant?    @relation("MessageSender", fields: [senderParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refiningNeed      Need?           @relation(fields: [refiningNeedId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceAttempt     EmpathyAttempt? @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  readStates ConversationReadState[]

  @@index([conversationId, createdAt])
  @@index([conversationId, kind, contentHash])
  @@index([senderParticipantId])
  @@index([refiningNeedId])
  @@index([sourceAttemptId])
  @@map("message")
}

/// sql_draft_one_per_point: UNIQUE (participant_id, kind,
/// coalesce(about_participant_id, attempt_id, share_offer_id)) is an
/// expression index — sql-only.sql.
model Draft {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId      String    @map("participant_id") @db.Uuid
  kind               DraftKind
  aboutParticipantId String?   @map("about_participant_id") @db.Uuid
  attemptId          String?   @map("attempt_id") @db.Uuid
  shareOfferId       String?   @map("share_offer_id") @db.Uuid
  content            String
  readyToShare       Boolean   @default(false) @map("ready_to_share")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant      Participant        @relation("DraftOwner", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  aboutParticipant Participant?       @relation("DraftAbout", fields: [aboutParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attempt          EmpathyAttempt?    @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shareOffer       ContextShareOffer? @relation(fields: [shareOfferId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([aboutParticipantId])
  @@index([attemptId])
  @@index([shareOfferId])
  @@map("draft")
}

model Milestone {
  key            String         @id
  ordinal        Int            @unique
  stageLabel     String         @map("stage_label")
  scope          MilestoneScope @default(participant)
  selfAssertable Boolean        @default(false) @map("self_assertable")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  reached ParticipantMilestone[]

  @@map("milestone")
}

model ParticipantMilestone {
  participantId String   @map("participant_id") @db.Uuid
  milestoneKey  String   @map("milestone_key")
  reachedAt     DateTime @default(now()) @map("reached_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  milestone   Milestone   @relation(fields: [milestoneKey], references: [key], onDelete: Restrict, onUpdate: NoAction)

  @@id([participantId, milestoneKey])
  @@index([milestoneKey, reachedAt])
  @@map("participant_milestone")
}

model AiMemory {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId String?      @map("participant_id") @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  kind          AiMemoryKind
  doc           Json
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([participantId, kind])
  @@unique([userId, kind])
  @@map("ai_memory")
}

/// intensity is the `intensity` domain (int CHECK 1..10) in the migration SQL.
model MoodReading {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  intensity     Int
  context       String?
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([participantId, recordedAt])
  @@map("mood_reading")
}

model RegulationEvent {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId   String         @map("participant_id") @db.Uuid
  type            RegulationType
  intensityBefore Int?           @map("intensity_before")
  intensityAfter  Int?           @map("intensity_after")
  completedAt     DateTime       @default(now()) @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([participantId, completedAt])
  @@map("regulation_event")
}

model Invitation {
  id                     String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId              String           @map("session_id") @db.Uuid
  invitedByParticipantId String           @map("invited_by_participant_id") @db.Uuid
  acceptedByUserId       String?          @map("accepted_by_user_id") @db.Uuid
  name                   String?
  status                 InvitationStatus @default(PENDING)
  messageConfirmedAt     DateTime?        @map("message_confirmed_at") @db.Timestamptz(3)
  expiresAt              DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt             DateTime?        @map("accepted_at") @db.Timestamptz(3)
  declinedAt             DateTime?        @map("declined_at") @db.Timestamptz(3)
  declineReason          String?          @map("decline_reason")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session              Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitedByParticipant Participant @relation(fields: [invitedByParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  acceptedByUser       User?       @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sessionId])
  @@index([invitedByParticipantId])
  @@index([status, expiresAt])
  @@index([acceptedByUserId])
  @@map("invitation")
}

/// sql_session_key_live: UNIQUE (session_id) WHERE destroyed_at IS NULL — sql-only.sql.
model SessionKey {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  keyId       String    @map("key_id")
  wrappedDek  Bytes     @map("wrapped_dek")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId])
  @@map("session_key")
}

/// sql_participant_key_live: UNIQUE (participant_id) WHERE destroyed_at IS NULL — sql-only.sql.
model ParticipantKey {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  keyId         String    @map("key_id")
  wrappedDek    Bytes     @map("wrapped_dek")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  destroyedAt   DateTime? @map("destroyed_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([participantId])
  @@map("participant_key")
}

// ----------------------------------------------------------------------------
// 1.2 Empathy and reconciler (5)
// ----------------------------------------------------------------------------

/// sql_attempt_one_live_per_direction: UNIQUE (author_participant_id,
/// subject_participant_id) WHERE status NOT IN ('SUPERSEDED','VALIDATED') — sql-only.sql.
model EmpathyAttempt {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  authorParticipantId  String         @map("author_participant_id") @db.Uuid
  subjectParticipantId String         @map("subject_participant_id") @db.Uuid
  round                Int            @default(1)
  supersedesAttemptId  String?        @map("supersedes_attempt_id") @db.Uuid
  content              String
  status               EmpathyStatus  @default(HELD)
  statusVersion        Int            @default(0) @map("status_version")
  submittedAt          DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  revealedAt           DateTime?      @map("revealed_at") @db.Timestamptz(3)
  deliveryStatus       DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(3)
  seenAt               DateTime?      @map("seen_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  authorParticipant  Participant      @relation("EmpathyAttemptAuthor", fields: [authorParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant      @relation("EmpathyAttemptSubject", fields: [subjectParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supersedesAttempt  EmpathyAttempt?  @relation("EmpathyAttemptSupersession", fields: [supersedesAttemptId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  supersededBy       EmpathyAttempt[] @relation("EmpathyAttemptSupersession")

  deliveredMessages Message[]
  drafts            Draft[]
  reviews           EmpathyReview[]
  reconcilerResults ReconcilerResult[]
  shareOffers       ContextShareOffer[]
  consents          Consent[]

  @@unique([authorParticipantId, subjectParticipantId, round])
  @@index([subjectParticipantId, revealedAt])
  @@index([supersedesAttemptId])
  @@map("empathy_attempt")
}

model EmpathyReview {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId             String    @map("attempt_id") @db.Uuid
  reviewerParticipantId String    @map("reviewer_participant_id") @db.Uuid
  validated             Boolean
  feedback              String?
  feedbackSentAt        DateTime? @map("feedback_sent_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt             EmpathyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewerParticipant Participant    @relation(fields: [reviewerParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  consents Consent[]

  @@unique([attemptId, reviewerParticipantId])
  @@index([reviewerParticipantId])
  @@map("empathy_review")
}

/// sql_result_one_current: UNIQUE (attempt_id) WHERE superseded_at IS NULL — sql-only.sql.
model ReconcilerResult {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId             String            @map("attempt_id") @db.Uuid
  subjectParticipantId  String            @map("subject_participant_id") @db.Uuid
  iteration             Int               @default(1)
  alignmentScore        Int               @map("alignment_score")
  alignmentSummary      String            @map("alignment_summary")
  gapSummary            String            @map("gap_summary")
  gapSeverity           GapSeverity       @map("gap_severity")
  correctlyIdentified   String[]          @default([]) @map("correctly_identified")
  missedFeelings        String[]          @default([]) @map("missed_feelings")
  misattributions       String[]          @default([])
  mostImportantGap      String?           @map("most_important_gap")
  recommendedAction     RecommenderAction @map("recommended_action")
  rationale             String
  sharingWouldHelp      Boolean           @map("sharing_would_help")
  suggestedShareFocus   String?           @map("suggested_share_focus")
  suggestedShareContent String?           @map("suggested_share_content")
  suggestedShareReason  String?           @map("suggested_share_reason")
  circuitBreakerTripped Boolean           @default(false) @map("circuit_breaker_tripped")
  supersededAt          DateTime?         @map("superseded_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  attempt            EmpathyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant    @relation(fields: [subjectParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  guidance    ReconcilerGuidance?
  shareOffers ContextShareOffer[]

  @@unique([attemptId, iteration])
  @@index([subjectParticipantId])
  @@map("reconciler_result")
}

model ReconcilerGuidance {
  resultId             String   @id @map("result_id") @db.Uuid
  authorParticipantId  String   @map("author_participant_id") @db.Uuid
  subjectParticipantId String   @map("subject_participant_id") @db.Uuid
  areaHint             String?  @map("area_hint")
  guidanceType         String?  @map("guidance_type")
  promptSeed           String?  @map("prompt_seed")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  result             ReconcilerResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorParticipant  Participant      @relation("GuidanceAuthor", fields: [authorParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjectParticipant Participant      @relation("GuidanceSubject", fields: [subjectParticipantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([authorParticipantId])
  @@index([subjectParticipantId])
  @@map("reconciler_guidance")
}

model ContextShareOffer {
  id                   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attemptId            String           @map("attempt_id") @db.Uuid
  resultId             String           @map("result_id") @db.Uuid
  subjectParticipantId String           @map("subject_participant_id") @db.Uuid
  iteration            Int              @default(1)
  status               ShareOfferStatus @default(PENDING)
  offerMessage         String?          @map("offer_message")
  suggestedContent     String?          @map("suggested_content")
  suggestedReason      String?          @map("suggested_reason")
  sharedContent        String?          @map("shared_content")
  sharedAt             DateTime?        @map("shared_at") @db.Timestamptz(3)
  declinedAt           DateTime?        @map("declined_at") @db.Timestamptz(3)
  offeredAt            DateTime?        @map("offered_at") @db.Timestamptz(3)
  deliveryStatus       DeliveryStatus   @default(PENDING) @map("delivery_status")
  deliveredAt          DateTime?        @map("delivered_at") @db.Timestamptz(3)
  seenAt               DateTime?        @map("seen_at") @db.Timestamptz(3)
  deliveryNotifiedAt   DateTime?        @map("delivery_notified_at") @db.Timestamptz(3)
  seenNotifiedAt       DateTime?        @map("seen_notified_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

