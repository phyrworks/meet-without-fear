/// name is GENERATED ALWAYS AS (nullif(trim(…), '')) STORED — created inline in
/// backend/scripts/target-shape/tables.sql; declared exactly as `prisma db pull` renders it (plain, no
/// default). The app never writes it.
/// kind: human / ai / persona (work-k5fk.1/.3). email is set exactly for a human (CHECK in tables.sql).
/// sql_user_one_ai: UNIQUE (kind) WHERE kind = 'ai' — sql-only.sql. @@unique([id, kind]) is the
/// target of the kind-carrying FKs (pattern K: UserIdentity, Persona).
model User {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      UserKind  @default(human)
  email     String?   @unique
  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  name      String?

  identities          UserIdentity[]
  persona             Persona?         @relation("PersonaUser")
  ownedPersonas       Persona[]        @relation("PersonaOwner")
  contacts            UserContact[]    @relation("UserContactOwner")
  contactOf           UserContact[]    @relation("UserContactContact")
  participants        Participant[]
  aiMemories          AiMemory[]
  invitationsAccepted Invitation[]     @relation("InvitationAcceptedBy")
  invitationsClaimed  Invitation[]     @relation("InvitationClaimedBy")
  reminders           Reminder[]
  reflections         Reflection[]
  devices             UserDevice[]
  preferences         UserPreferences?
  memories            UserMemory[]
  featureStates       FeatureState[]
  keys                UserKey[]
  sessionsArchived    Session[]

  @@unique([id, kind])
  @@map("user")
}

/// A human's sign-in identity (work-k5fk.1): written only by app.create_user, deleted by
/// app.anonymize_user_account. mwf_app holds no privilege on it — the app resolves a subject through
/// mwf_auth's app.resolve_user. userKind is always human (CHECK; pattern K).
model UserIdentity {
  provider  IdentityProvider
  subject   String
  userId    String           @map("user_id") @db.Uuid
  userKind  UserKind         @default(human) @map("user_kind")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId, userKind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)

  @@id([provider, subject])
  @@unique([userId, provider])
  @@map("user_identity")
}

/// A modeled person (work-k5fk.3): the persona's user row and its human owner, both pinned by kind
/// (CHECKs; pattern K). kind is always persona, ownerKind always human.
/// What one user calls another (work-k5fk.2): private to userId, never shown to the contact.
model UserContact {
  userId        String   @map("user_id") @db.Uuid
  contactUserId String   @map("contact_user_id") @db.Uuid
  nickname      String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User @relation("UserContactOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  contact User @relation("UserContactContact", fields: [contactUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, contactUserId])
  @@index([contactUserId])
  @@map("user_contact")
}

model Persona {
  userId      String   @map("user_id") @db.Uuid
  kind        UserKind @default(persona)
  ownerUserId String   @map("owner_user_id") @db.Uuid
  ownerKind   UserKind @default(human) @map("owner_kind")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User @relation("PersonaUser", fields: [userId, kind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)
  owner User @relation("PersonaOwner", fields: [ownerUserId, ownerKind], references: [id, kind], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, kind])
  @@index([ownerUserId])
  @@map("persona")
}

