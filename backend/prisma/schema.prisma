  @@index([userId, status])
  @@index([sessionId])
  @@map("user_memory")
}

model FeatureState {
  userId    String   @map("user_id") @db.Uuid
  feature   String
  doc       Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, feature])
  @@map("feature_state")
}

/// sql_user_key_live: UNIQUE (user_id) WHERE destroyed_at IS NULL — sql-only.sql.
model UserKey {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  keyId       String    @map("key_id")
  wrappedDek  Bytes     @map("wrapped_dek")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId])
  @@map("user_key")
}

// ----------------------------------------------------------------------------
// 1.8 Telemetry (1)
// ----------------------------------------------------------------------------

model BrainActivity {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId        String?        @map("session_id") @db.Uuid
  reflectionId     String?        @map("reflection_id") @db.Uuid
  participantId    String?        @map("participant_id") @db.Uuid
  turnId           String?        @map("turn_id")
  activityType     ActivityType   @map("activity_type")
  callType         BrainCallType? @map("call_type")
  model            String
  input            Json?
  output           Json?
  metadata         Json?
  structuredOutput Json?          @map("structured_output")
  tokenCountInput  Int            @default(0) @map("token_count_input")
  tokenCountOutput Int            @default(0) @map("token_count_output")
  durationMs       Int            @default(0) @map("duration_ms")
  cost             Decimal        @default(0) @db.Decimal(10, 6)
  status           ActivityStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(3)

  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reflection  Reflection?  @relation(fields: [reflectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId])
  @@index([reflectionId])
  @@index([participantId])
  @@index([turnId])
  @@index([createdAt])
  @@map("brain_activity")
}

