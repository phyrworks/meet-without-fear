/// sql_need_live: (session_id, user_id) WHERE deleted_at IS NULL — sql-only.sql.
model Need {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId          String       @map("session_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  label              String
  category           NeedCategory
  evidence           String[]     @default(dbgenerated("('{}'::text[])::ciphertext_list"))
  aiConfidence       Float        @map("ai_confidence") @db.Real
  confirmedAt        DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  lockedAt           DateTime?    @map("locked_at") @db.Timestamptz(3)
  supersededByNeedId String?      @map("superseded_by_need_id") @db.Uuid
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant      Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  supersededByNeed Need?       @relation("NeedSupersession", fields: [supersededByNeedId, sessionId, userId], references: [id, sessionId, userId], onDelete: SetNull, onUpdate: NoAction)
  supersedes       Need[]      @relation("NeedSupersession")

  share            NeedShare?
  refiningMessages Message[]
  consents         Consent[]
  consentNeedPins  Consent[]  @relation("ConsentNeedPin")
  needShareNeedPin NeedShare? @relation("NeedShareNeedPin")

  @@unique([id, sessionId])
  @@unique([id, sessionId, userId])
  @@index([supersededByNeedId])
  @@index([sessionId, userId])
  @@map("need")
}

model NeedShare {
  needId     String       @id @map("need_id") @db.Uuid
  sessionId  String       @map("session_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  category   NeedCategory
  sharedText String       @map("shared_text")
  sharedAt   DateTime     @default(now()) @map("shared_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  need        Need        @relation(fields: [needId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  dispositions            NeedDisposition[]
  proposalNeeds           ProposalNeed[]
  needDispositionNeedPins NeedDisposition[] @relation("NeedDispositionNeedPin")
  needPin                 Need              @relation("NeedShareNeedPin", fields: [needId, sessionId, userId], references: [id, sessionId, userId], onUpdate: NoAction)
  proposalNeedNeedPins    ProposalNeed[]    @relation("ProposalNeedNeedPin")

  @@unique([needId, sessionId])
  @@unique([needId, sessionId, userId])
  @@index([sessionId, revokedAt])
  @@index([sessionId, userId])
  @@map("need_share")
}

/// sql_disposition_one_current: UNIQUE (session_id, user_id) WHERE is_current — sql-only.sql.
model NeedDisposition {
  needId    String                @map("need_id") @db.Uuid
  sessionId String                @map("session_id") @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  status    NeedDispositionStatus @default(OPEN)
  isCurrent Boolean               @default(false) @map("is_current")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  need        NeedShare   @relation(fields: [needId], references: [needId], onDelete: Cascade, onUpdate: NoAction)
  needPin     NeedShare   @relation("NeedDispositionNeedPin", fields: [needId, sessionId], references: [needId, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, userId, needId])
  @@index([needId])
  @@map("need_disposition")
}

model Proposal {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId            String         @map("session_id") @db.Uuid
  createdByUserId      String?        @map("created_by_user_id") @db.Uuid
  source               ProposalSource @default(USER_SUBMITTED)
  kind                 ProposalKind   @default(SHARED_PROPOSAL)
  status               ProposalStatus @default(ACTIVE)
  description          String
  duration             String?
  measureOfSuccess     String?        @map("measure_of_success")
  unresolvedNeedLabels String[]       @default(dbgenerated("('{}'::text[])::ciphertext_list")) @map("unresolved_need_labels")
  removedAt            DateTime?      @map("removed_at") @db.Timestamptz(3)
  removedByUserId      String?        @map("removed_by_user_id") @db.Uuid
  removalReason        String?        @map("removal_reason")
  sharedAt             DateTime?      @map("shared_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session              Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByParticipant Participant? @relation("ProposalCreator", fields: [sessionId, createdByUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  removedByParticipant Participant? @relation("ProposalRemover", fields: [sessionId, removedByUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  subchats                     Conversation[]
  consents                     Consent[]
  needs                        ProposalNeed[]
  choices                      ProposalChoice[]
  revisions                    ProposalRevision[]
  agreement                    Agreement?
  followUps                    FollowUp[]
  agreementProposalPin         Agreement?         @relation("AgreementProposalPin")
  consentProposalPins          Consent[]          @relation("ConsentProposalPin")
  proposalChoiceProposalPins   ProposalChoice[]   @relation("ProposalChoiceProposalPin")
  proposalNeedProposalPins     ProposalNeed[]     @relation("ProposalNeedProposalPin")
  proposalRevisionProposalPins ProposalRevision[] @relation("ProposalRevisionProposalPin")

  @@unique([id, sessionId])
  @@index([sessionId, status])
  @@index([sessionId, createdByUserId])
  @@index([sessionId, removedByUserId])
  @@map("proposal")
}

model ProposalNeed {
  proposalId String   @map("proposal_id") @db.Uuid
  needId     String   @map("need_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  need        NeedShare @relation(fields: [needId], references: [needId], onDelete: Cascade, onUpdate: NoAction)
  needPin     NeedShare @relation("ProposalNeedNeedPin", fields: [needId, sessionId], references: [needId, sessionId], onDelete: Cascade, onUpdate: NoAction)
  proposalPin Proposal  @relation("ProposalNeedProposalPin", fields: [proposalId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@id([proposalId, needId])
  @@index([needId])
  @@map("proposal_need")
}

model ProposalChoice {
  proposalId String         @map("proposal_id") @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  decision   ChoiceDecision
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal    Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participant Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  proposalPin Proposal    @relation("ProposalChoiceProposalPin", fields: [proposalId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@id([proposalId, sessionId, userId])
  @@index([sessionId, userId])
  @@map("proposal_choice")
}

model ProposalRevision {
  id          String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  proposalId  String                  @map("proposal_id") @db.Uuid
  sessionId   String                  @map("session_id") @db.Uuid
  actorUserId String?                 @map("actor_user_id") @db.Uuid
  action      RevisionAction
  before      Json?
  after       Json?
  reason      ProposalRevisionReason?
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal         Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorParticipant Participant? @relation(fields: [sessionId, actorUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  proposalPin      Proposal     @relation("ProposalRevisionProposalPin", fields: [proposalId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@index([proposalId, createdAt])
  @@index([sessionId, actorUserId])
  @@map("proposal_revision")
}

model Agreement {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  proposalId       String          @unique @map("proposal_id") @db.Uuid
  type             AgreementType
  status           AgreementStatus @default(AGREED)
  description      String
  duration         String?
  measureOfSuccess String?         @map("measure_of_success")
  followUpAt       DateTime?       @map("follow_up_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  parties                     AgreementParty[]
  followUps                   FollowUp[]
  proposalPin                 Proposal         @relation("AgreementProposalPin", fields: [proposalId, sessionId], references: [id, sessionId], onUpdate: NoAction)
  agreementPartyAgreementPins AgreementParty[] @relation("AgreementPartyAgreementPin")

  @@unique([id, sessionId])
  @@unique([proposalId, sessionId])
  @@index([sessionId, status])
  @@map("agreement")
}

model AgreementParty {
  agreementId String   @map("agreement_id") @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  agreedAt    DateTime @default(now()) @map("agreed_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement    Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participant  Participant @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)
  agreementPin Agreement   @relation("AgreementPartyAgreementPin", fields: [agreementId, sessionId], references: [id, sessionId], onDelete: Cascade, onUpdate: NoAction)

  @@id([agreementId, sessionId, userId])
  @@index([sessionId, userId])
  @@map("agreement_party")
}

model SessionClosure {
  sessionId      String        @id @map("session_id") @db.Uuid
  kind           ClosureKind
  reason         ClosureReason
  summary        String
  closedByUserId String?       @map("closed_by_user_id") @db.Uuid
  checkInAt      DateTime?     @map("check_in_at") @db.Timestamptz(3)
  closedAt       DateTime      @default(now()) @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  session             Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  closedByParticipant Participant? @relation(fields: [sessionId, closedByUserId], references: [sessionId, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, closedByUserId])
  @@index([sessionId, closedByUserId])
  @@map("session_closure")
}

// ----------------------------------------------------------------------------
// 1.5 Follow-up (4)
// ----------------------------------------------------------------------------

/// sql_follow_up_due: (scheduled_for) WHERE status = 'SCHEDULED' — sql-only.sql.
model FollowUp {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId          String         @map("session_id") @db.Uuid
  agreementId        String?        @map("agreement_id") @db.Uuid
  proposalId         String?        @map("proposal_id") @db.Uuid
  type               FollowUpType
  scope              FollowUpScope  @default(SHARED)
