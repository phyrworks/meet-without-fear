  {
    "id": "rowLevelSecurity.public.UserMemory.disable",
    "label": "Disable row-level security on \"UserMemory\"",
    "operationClass": "widening",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "rowLevelSecurity",
        "name": "UserMemory"
      }
    },
    "precheck": [
      {
        "description": "check RLS is currently enabled on \"UserMemory\"",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"relnamespace\" WHERE (\"n\".\"nspname\" = $1 AND \"c\".\"relname\" = $2 AND \"c\".\"relrowsecurity\")) AS \"result\"",
        "params": [
          "public",
          "UserMemory"
        ]
      }
    ],
    "execute": [
      {
        "description": "disable row-level security on \"UserMemory\"",
        "sql": "ALTER TABLE \"public\".\"UserMemory\" DISABLE ROW LEVEL SECURITY",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify row-level security is disabled on \"UserMemory\"",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"relnamespace\" WHERE (\"n\".\"nspname\" = $1 AND \"c\".\"relname\" = $2 AND NOT (\"c\".\"relrowsecurity\"))) AS \"result\"",
        "params": [
          "public",
          "UserMemory"
        ]
      }
    ]
  },
