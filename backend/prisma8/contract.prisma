// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Relationship {
    id                  String               @id(map: "Relationship_pkey")
    createdAt           TimestampString(3)   @default(now())
    updatedAt           TimestampString(3)
    relationshipMembers RelationshipMember[]
    sessions            Session[]
  }

  model Session {
    id                           String                        @id(map: "Session_pkey")
    relationshipId               String
    status                       pg.enum(SessionStatus)        @default("CREATED")
    createdAt                    TimestampString(3)            @default(now())
    updatedAt                    TimestampString(3)
    resolvedAt                   TimestampString(3)?
    _type                        pg.enum(SessionType)          @default("CONFLICT_RESOLUTION") @map("type")
    topicFrame                   String?
    topicFrameConfirmedAt        TimestampString(3)?
    previousSessionId            String?
    brainActivities              BrainActivity[]
    consentRecords               ConsentRecord[]
    emotionalExerciseCompletions EmotionalExerciseCompletion[]
    empathyAttempts              EmpathyAttempt[]
    empathyDrafts                EmpathyDraft[]
    empathyValidations           EmpathyValidation[]
    innerWorkSessions            InnerWorkSession[]
    invitations                  Invitation[]
    messages                     Message[]
    reconcilerResults            ReconcilerResult[]
    refinementAttemptCounters    RefinementAttemptCounter[]
    sharedVessel                 SharedVessel?
    stage4Closure                Stage4Closure?
    stage4NeedCoverages          Stage4NeedCoverage[]
    stage4NeedDeclinations       Stage4NeedDeclination[]
    stage4ProposalSelections     Stage4ProposalSelection[]
    stage4SubChats               Stage4SubChat[]
    stageProgresses              StageProgress[]
    strategyProposals            StrategyProposal[]
    strategyRankings             StrategyRanking[]
    tendingAdjustments           TendingAdjustment[]
    tendingBetweenPeriodNotes    TendingBetweenPeriodNote[]
    tendingCheckins              TendingCheckin[]
    tendingCoordinationCycles    TendingCoordinationCycle[]
    tendingEntries               TendingEntry[]
    tendingNeedOutcomes          TendingNeedOutcome[]
    tendingReminders             TendingReminder[]
    userMemories                 UserMemory[]
    userVessels                  UserVessel[]
    validationFeedbackDrafts     ValidationFeedbackDraft[]
    previousSession              Session?                      @relation(name: "Session_previousSessionId_fkey", fields: [previousSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Session_previousSessionId_fkey")
    sessions                     Session[]                     @relation(name: "Session_previousSessionId_fkey")
    relationship                 Relationship                  @relation(fields: [relationshipId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Session_relationshipId_fkey")

    @@index([previousSessionId], map: "Session_previousSessionId_idx")
    @@index([relationshipId], map: "Session_relationshipId_idx")
    @@index([status], map: "Session_status_idx")
    @@index([_type], map: "Session_type_idx")
  }

  model SharedVessel {
    id                String             @id(map: "SharedVessel_pkey")
    sessionId         String
    createdAt         TimestampString(3) @default(now())
    updatedAt         TimestampString(3)
    agreements        Agreement[]
    commonGrounds     CommonGround[]
    consentedContents ConsentedContent[]
    session           Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SharedVessel_sessionId_fkey")

    @@index([sessionId], map: "SharedVessel_sessionId_key", unique: true)
  }

  model User {
    id                                String                        @id(map: "User_pkey")
    clerkId                           String?
    email                             String
    name                              String?
    firstName                         String?
    lastName                          String?
    pushToken                         String?
    biometricEnabled                  Boolean                       @default(false)
    biometricEnrolledAt               TimestampString(3)?
    createdAt                         TimestampString(3)            @default(now())
    updatedAt                         TimestampString(3)
    memoryPreferences                 Jsonb?
    lastMoodIntensity                 Int?
    notificationPreferences           Jsonb?
    globalFacts                       Jsonb?
    privacyPreferences                Jsonb?
    consentedContents                 ConsentedContent[]
    emotionalExerciseCompletions      EmotionalExerciseCompletion[]
    empathyAttempts                   EmpathyAttempt[]
    empathyDrafts                     EmpathyDraft[]
    empathyValidations                EmpathyValidation[]
    gratitudeEntries                  GratitudeEntry[]
    gratitudePreferences              GratitudePreferences?
    innerWorkSessions                 InnerWorkSession[]
    insights                          Insight[]
    invitations                       Invitation[]
    meditationFavorites               MeditationFavorite[]
    meditationPreferences             MeditationPreferences?
    meditationSessions                MeditationSession[]
    meditationStats                   MeditationStats?
    messages                          Message[]
    needScores                        NeedScore[]
    needsAssessmentState              NeedsAssessmentState?
    people                            Person[]
    recurringThemes                   RecurringTheme[]
    relationshipMembers               RelationshipMember[]
    savedMeditations                  SavedMeditation[]
    stage4ProposalSelections          Stage4ProposalSelection[]
    stage4SubChats                    Stage4SubChat[]
    stageProgresses                   StageProgress[]
    strategyRankings                  StrategyRanking[]
    tendingAdjustments                TendingAdjustment[]
    tendingBetweenPeriodNotes         TendingBetweenPeriodNote[]
    tendingCheckins                   TendingCheckin[]
    tendingCoordinationCycles         TendingCoordinationCycle[]
    tendingEntryOutcomes              TendingEntryOutcome[]
    tendingReminders                  TendingReminder[]
    tendingResponses                  TendingResponse[]
    userMemories                      UserMemory[]
    userVessels                       UserVessel[]
    validationFeedbackDrafts          ValidationFeedbackDraft[]
    consentRecords                    ConsentRecord[]               @relation(name: "ConsentRecord_requestedByUserId_fkey")
    consentRecordsConsentRecord       ConsentRecord[]               @relation(name: "ConsentRecord_userId_fkey")
    strategyProposals                 StrategyProposal[]            @relation(name: "StrategyProposal_createdByUserId_fkey")
    strategyProposalsStrategyProposal StrategyProposal[]            @relation(name: "StrategyProposal_removedByUserId_fkey")

    @@index([clerkId], map: "User_clerkId_key", unique: true)
    @@index([email], map: "User_email_key", unique: true)
  }

  model ConsentRecord {
    id                String                      @id(map: "ConsentRecord_pkey")
    userId            String
    sessionId         String?
    targetType        pg.enum(ConsentContentType)
    targetId          String?
    requestedByUserId String
    decision          pg.enum(ConsentDecision)?
    decidedAt         TimestampString(3)?
    revokedAt         TimestampString(3)?
    metadata          Jsonb?
    createdAt         TimestampString(3)          @default(now())
    consentedContents ConsentedContent[]
    empathyAttempts   EmpathyAttempt[]
    strategyProposals StrategyProposal[]
    requestedByUser   User                        @relation(name: "ConsentRecord_requestedByUserId_fkey", fields: [requestedByUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ConsentRecord_requestedByUserId_fkey", index: false)
    session           Session?                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ConsentRecord_sessionId_fkey", index: false)
    user              User                        @relation(name: "ConsentRecord_userId_fkey", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ConsentRecord_userId_fkey", index: "ConsentRecord_userId_sessionId_targetType_decidedAt_idx")

    @@index([userId, sessionId, targetType, decidedAt], map: "ConsentRecord_userId_sessionId_targetType_decidedAt_idx")
  }

  model StrategyProposal {
    id                       String                        @id(map: "StrategyProposal_pkey")
    sessionId                String
    createdByUserId          String?
    description              String
    needsAddressed           String[]?                     @noCheck(elementNotNull)
    duration                 String?
    measureOfSuccess         String?
    source                   pg.enum(StrategySource)       @default("USER_SUBMITTED")
    createdAt                TimestampString(3)            @default(now())
    updatedAt                TimestampString(3)
    consentRecordId          String?
    kind                     pg.enum(Stage4ProposalKind)   @default("SHARED_PROPOSAL")
    status                   pg.enum(Stage4ProposalStatus) @default("ACTIVE")
    removedAt                TimestampString(3)?
    removedByUserId          String?
    removalReason            String?
    parentProposalId         String?
    coverageSummary          Jsonb?
    capturedFromMessageId    String?
    agreements               Agreement[]
    stage4ProposalRevisions  Stage4ProposalRevision[]
    stage4ProposalSelections Stage4ProposalSelection[]
    strategyProposalNeeds    StrategyProposalNeed[]
    consentRecord            ConsentRecord?                @relation(fields: [consentRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "StrategyProposal_consentRecordId_fkey", index: false)
    createdByUser            User?                         @relation(name: "StrategyProposal_createdByUserId_fkey", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "StrategyProposal_createdByUserId_fkey", index: false)
    removedByUser            User?                         @relation(name: "StrategyProposal_removedByUserId_fkey", fields: [removedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "StrategyProposal_removedByUserId_fkey", index: false)
    session                  Session                       @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StrategyProposal_sessionId_fkey")

    @@index([parentProposalId], map: "StrategyProposal_parentProposalId_idx")
    @@index([sessionId], map: "StrategyProposal_sessionId_idx")
    @@index([sessionId, status], map: "StrategyProposal_sessionId_status_idx")
  }

  model Agreement {
    id               String                   @id(map: "Agreement_pkey")
    sharedVesselId   String
    description      String
    _type            pg.enum(AgreementType)   @map("type")
    status           pg.enum(AgreementStatus) @default("PROPOSED")
    agreedByA        Boolean                  @default(false)
    agreedByB        Boolean                  @default(false)
    agreedAt         TimestampString(3)?
    followUpDate     TimestampString(3)?
    completedAt      TimestampString(3)?
    proposalId       String?
    duration         String?
    measureOfSuccess String?
    tendingEntries   TendingEntry[]
    proposal         StrategyProposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Agreement_proposalId_fkey", index: false)
    sharedVessel     SharedVessel             @relation(fields: [sharedVesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Agreement_sharedVesselId_fkey")

    @@index([sharedVesselId], map: "Agreement_sharedVesselId_idx")
  }

  model UserVessel {
    id                   String                       @id(map: "UserVessel_pkey")
    userId               String
    sessionId            String
    createdAt            TimestampString(3)           @default(now())
    updatedAt            TimestampString(3)
    conversationSummary  String?
    lastSeenChatItemId   String?
    lastViewedAt         TimestampString(3)?
    notableFacts         Jsonb?
    lastViewedShareTabAt TimestampString(3)?
    contentEmbedding     pgvector.Vector(1024)?
    archivedAt           TimestampString(3)?
    lastActiveAt         TimestampString(3)?
    boundaries           Boundary[]
    emotionalReadings    EmotionalReading[]
    identifiedNeeds      IdentifiedNeed[]
    userDocuments        UserDocument[]
    userEvents           UserEvent[]
    session              Session                      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserVessel_sessionId_fkey")
    user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserVessel_userId_fkey")

    @@index([sessionId], map: "UserVessel_sessionId_idx")
    @@index([userId], map: "UserVessel_userId_idx")
    @@index([userId, sessionId], map: "UserVessel_userId_sessionId_key", unique: true)
  }

  model Boundary {
    id            String             @id(map: "Boundary_pkey")
    vesselId      String
    description   String
    nonNegotiable Boolean            @default(false)
    createdAt     TimestampString(3) @default(now())
    vessel        UserVessel         @relation(fields: [vesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Boundary_vesselId_fkey")

    @@index([vesselId], map: "Boundary_vesselId_idx")
  }

  model InnerWorkMessage {
    id                String               @id(map: "InnerWorkMessage_pkey")
    sessionId         String
    role              pg.enum(MessageRole)
    content           String
    timestamp         TimestampString(3)   @default(now())
    innerWorkSessions InnerWorkSession[]
    session           InnerWorkSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "InnerWorkMessage_sessionId_fkey", index: "InnerWorkMessage_sessionId_timestamp_idx")

    @@index([sessionId, timestamp], map: "InnerWorkMessage_sessionId_timestamp_idx")
  }

  model InnerWorkSession {
    id                     String                       @id(map: "InnerWorkSession_pkey")
    userId                 String
    title                  String?
    summary                String?
    theme                  String?
    status                 pg.enum(InnerWorkStatus)     @default("ACTIVE")
    createdAt              TimestampString(3)           @default(now())
    updatedAt              TimestampString(3)
    linkedAtStage          Int?
    linkedPartnerSessionId String?
    linkedTrigger          String?
    conversationSummary    String?
    contentEmbedding       pgvector.Vector(1024)?
    distilledAt            TimestampString(3)?
    linkedAtMessageId      String?
    contextSummarySnapshot String?
    brainActivities        BrainActivity[]
    innerWorkMessages      InnerWorkMessage[]
    sessionTakeaways       SessionTakeaway[]
    linkedAtMessage        InnerWorkMessage?            @relation(fields: [linkedAtMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "InnerWorkSession_linkedAtMessageId_fkey")
    linkedPartnerSession   Session?                     @relation(fields: [linkedPartnerSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "InnerWorkSession_linkedPartnerSessionId_fkey")
    user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "InnerWorkSession_userId_fkey", index: "InnerWorkSession_userId_updatedAt_idx")

    @@index([linkedAtMessageId], map: "InnerWorkSession_linkedAtMessageId_idx")
    @@index([linkedPartnerSessionId], map: "InnerWorkSession_linkedPartnerSessionId_idx")
    @@index([status], map: "InnerWorkSession_status_idx")
    @@index([userId, updatedAt], map: "InnerWorkSession_userId_updatedAt_idx")
  }

  model BrainActivity {
    id                 String                          @id(map: "BrainActivity_pkey")
    sessionId          String?
    turnId             String?
    activityType       pg.enum(ActivityType)
    _model             String                          @map("model")
    input              Jsonb?
    output             Jsonb?
    metadata           Jsonb?
    tokenCountInput    Int                             @default(0)
    tokenCountOutput   Int                             @default(0)
    cost               Float                           @default(0)
    durationMs         Int                             @default(0)
    status             pg.enum(ActivityStatus)         @default("PENDING")
    createdAt          TimestampString(3)              @default(now())
    completedAt        TimestampString(3)?
    callType           pg.enum(BrainActivityCallType)?
    structuredOutput   Jsonb?
    innerWorkSessionId String?
    innerWorkSession   InnerWorkSession?               @relation(fields: [innerWorkSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "BrainActivity_innerWorkSessionId_fkey")
    session            Session?                        @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "BrainActivity_sessionId_fkey")

    @@index([activityType], map: "BrainActivity_activityType_idx")
    @@index([createdAt], map: "BrainActivity_createdAt_idx")
    @@index([innerWorkSessionId], map: "BrainActivity_innerWorkSessionId_idx")
    @@index([sessionId], map: "BrainActivity_sessionId_idx")
    @@index([turnId], map: "BrainActivity_turnId_idx")
  }

  model CommonGround {
    id             String                @id(map: "CommonGround_pkey")
    sharedVesselId String
    need           String
    category       pg.enum(NeedCategory)
    confirmedByA   Boolean               @default(false)
    confirmedByB   Boolean               @default(false)
    confirmedAt    TimestampString(3)?
    sharedVessel   SharedVessel          @relation(fields: [sharedVesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CommonGround_sharedVesselId_fkey")

    @@index([sharedVesselId], map: "CommonGround_sharedVesselId_idx")
  }

  model IdentifiedNeed {
    id                    String                 @id(map: "IdentifiedNeed_pkey")
    vesselId              String
    need                  String
    category              pg.enum(NeedCategory)
    evidence              String[]?              @noCheck(elementNotNull)
    confirmed             Boolean                @default(false)
    aiConfidence          Float
    createdAt             TimestampString(3)     @default(now())
    deletedAt             TimestampString(3)?
    lockedAt              TimestampString(3)?
    supersededByNeedId    String?
    consentedContent      ConsentedContent?
    messages              Message[]
    strategyProposalNeeds StrategyProposalNeed[]
    supersededByNeed      IdentifiedNeed?        @relation(name: "IdentifiedNeed_supersededByNeedId_fkey", fields: [supersededByNeedId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "IdentifiedNeed_supersededByNeedId_fkey")
    identifiedNeeds       IdentifiedNeed[]       @relation(name: "IdentifiedNeed_supersededByNeedId_fkey")
    vessel                UserVessel             @relation(fields: [vesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "IdentifiedNeed_vesselId_fkey")

    @@index([deletedAt], map: "IdentifiedNeed_deletedAt_idx")
    @@index([lockedAt], map: "IdentifiedNeed_lockedAt_idx")
    @@index([supersededByNeedId], map: "IdentifiedNeed_supersededByNeedId_idx")
    @@index([vesselId], map: "IdentifiedNeed_vesselId_idx")
  }

  model ConsentedContent {
    id                 String              @id(map: "ConsentedContent_pkey")
    sharedVesselId     String
    sourceUserId       String?
    originalNeedId     String?
    transformedContent String
    consentedAt        TimestampString(3)  @default(now())
    consentActive      Boolean             @default(true)
    revokedAt          TimestampString(3)?
    consentRecordId    String
    consentRecord      ConsentRecord       @relation(fields: [consentRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "ConsentedContent_consentRecordId_fkey", index: false)
    originalNeed       IdentifiedNeed?     @relation(fields: [originalNeedId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "ConsentedContent_originalNeedId_fkey")
    sharedVessel       SharedVessel        @relation(fields: [sharedVesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ConsentedContent_sharedVesselId_fkey")
    sourceUser         User?               @relation(fields: [sourceUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "ConsentedContent_sourceUserId_fkey")

    @@index([originalNeedId], map: "ConsentedContent_originalNeedId_key", unique: true)
    @@index([sharedVesselId], map: "ConsentedContent_sharedVesselId_idx")
    @@index([sourceUserId], map: "ConsentedContent_sourceUserId_idx")
  }

  model EmotionalExerciseCompletion {
    id              String                @id(map: "EmotionalExerciseCompletion_pkey")
    sessionId       String
    userId          String
    _type           pg.enum(ExerciseType) @map("type")
    completedAt     TimestampString(3)    @default(now())
    intensityBefore Int?
    intensityAfter  Int?
    session         Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmotionalExerciseCompletion_sessionId_fkey", index: "EmotionalExerciseCompletion_sessionId_userId_completedAt_idx")
    user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmotionalExerciseCompletion_userId_fkey", index: false)

    @@index([sessionId, userId, completedAt], map: "EmotionalExerciseCompletion_sessionId_userId_completedAt_idx")
  }

  model EmotionalReading {
    id        String             @id(map: "EmotionalReading_pkey")
    vesselId  String
    intensity Int
    context   String?
    stage     Int
    timestamp TimestampString(3) @default(now())
    vessel    UserVessel         @relation(fields: [vesselId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmotionalReading_vesselId_fkey", index: "EmotionalReading_vesselId_timestamp_idx")

    @@index([vesselId, timestamp], map: "EmotionalReading_vesselId_timestamp_idx")
  }

  model EmpathyDraft {
    id              String             @id(map: "EmpathyDraft_pkey")
    sessionId       String
    userId          String
    content         String
    readyToShare    Boolean            @default(false)
    version         Int                @default(1)
    updatedAt       TimestampString(3)
    createdAt       TimestampString(3) @default(now())
    empathyAttempts EmpathyAttempt[]
    session         Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmpathyDraft_sessionId_fkey", index: "EmpathyDraft_sessionId_userId_key")
    user            User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmpathyDraft_userId_fkey", index: false)

    @@index([sessionId, userId], map: "EmpathyDraft_sessionId_userId_key", unique: true)
  }

  model EmpathyAttempt {
    id                 String                               @id(map: "EmpathyAttempt_pkey")
    draftId            String?
    sessionId          String
    sourceUserId       String?
    content            String
    sharedAt           TimestampString(3)                   @default(now())
    consentRecordId    String?
    revealedAt         TimestampString(3)?
    revisionCount      Int                                  @default(0)
    status             pg.enum(EmpathyStatus)               @default("HELD")
    deliveredAt        TimestampString(3)?
    deliveryStatus     pg.enum(SharedContentDeliveryStatus) @default("PENDING")
    seenAt             TimestampString(3)?
    statusVersion      Int                                  @default(0)
    empathyValidations EmpathyValidation[]
    consentRecord      ConsentRecord?                       @relation(fields: [consentRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EmpathyAttempt_consentRecordId_fkey", index: false)
    draft              EmpathyDraft?                        @relation(fields: [draftId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EmpathyAttempt_draftId_fkey", index: false)
    session            Session                              @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmpathyAttempt_sessionId_fkey", index: "EmpathyAttempt_sessionId_sourceUserId_key")
    sourceUser         User?                                @relation(fields: [sourceUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EmpathyAttempt_sourceUserId_fkey", index: false)

    @@index([sessionId, sourceUserId], map: "EmpathyAttempt_sessionId_sourceUserId_key", unique: true)
  }

  model EmpathyValidation {
    id             String              @id(map: "EmpathyValidation_pkey")
    attemptId      String
    sessionId      String
    userId         String?
    validated      Boolean
    feedback       String?
    feedbackShared Boolean             @default(false)
    validatedAt    TimestampString(3)? @default(now())
    attempt        EmpathyAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmpathyValidation_attemptId_fkey", index: "EmpathyValidation_attemptId_userId_key")
    session        Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EmpathyValidation_sessionId_fkey", index: false)
    user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EmpathyValidation_userId_fkey", index: false)

    @@index([attemptId, userId], map: "EmpathyValidation_attemptId_userId_key", unique: true)
  }

  model GlobalLibraryItem {
    id                  String                       @id(map: "GlobalLibraryItem_pkey")
    title               String
    description         String
    category            String
    source              pg.enum(GlobalLibrarySource)
    createdAt           TimestampString(3)           @default(now())
    updatedAt           TimestampString(3)
    contributedBy       String?
    contributionConsent TimestampString(3)?

    @@index([category], map: "GlobalLibraryItem_category_idx")
    @@index([source], map: "GlobalLibraryItem_source_idx")
  }

  model GratitudeEntry {
    id                  String             @id(map: "GratitudeEntry_pkey")
    userId              String
    content             String
    voiceRecorded       Boolean            @default(false)
    createdAt           TimestampString(3) @default(now())
    extractedPeople     String[]?          @default([]) @noCheck(elementNotNull)
    extractedPlaces     String[]?          @default([]) @noCheck(elementNotNull)
    extractedActivities String[]?          @default([]) @noCheck(elementNotNull)
    extractedEmotions   String[]?          @default([]) @noCheck(elementNotNull)
    extractedThemes     String[]?          @default([]) @noCheck(elementNotNull)
    linkedNeedIds       Int[]?             @default([]) @noCheck(elementNotNull)
    linkedConflictId    String?
    sentimentScore      Float?
    aiResponse          String?
    user                User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "GratitudeEntry_userId_fkey", index: "GratitudeEntry_userId_createdAt_idx")

    @@index([userId, createdAt], map: "GratitudeEntry_userId_createdAt_idx")
  }

  model GratitudePreferences {
    id              String    @id(map: "GratitudePreferences_pkey")
    userId          String
    enabled         Boolean   @default(true)
    frequency       Int       @default(1)
    preferredTimes  String[]? @default(["20:00"]) @noCheck(elementNotNull)
    weekdayOnly     Boolean   @default(false)
    quietHoursStart String?
    quietHoursEnd   String?
    user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "GratitudePreferences_userId_fkey")

    @@index([userId], map: "GratitudePreferences_userId_key", unique: true)
  }

  model Insight {
    id        String               @id(map: "Insight_pkey")
    userId    String
    _type     pg.enum(InsightType) @map("type")
    summary   String
    data      Jsonb
    priority  Int                  @default(0)
    dismissed Boolean              @default(false)
    expiresAt TimestampString(3)?
