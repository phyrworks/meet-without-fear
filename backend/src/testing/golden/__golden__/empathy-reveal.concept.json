      "<message:ada@main#10>": {
        "content": "I'm glad. Now let's build some empathy for your partner's perspective.",
        "content_hash": "2d2ba9f01a25cc167953cca7c5cb7533b5ef4b9819cdc0a4ee4298d34aecc720",
