      },
      "<message:bob@main#4>": {
        "content": "I feel like they don't see how much I'm dealing with at work.",
        "content_hash": "7614eba9a318757de566b0e3fa59ddfbbf5ab1e0341f74fbc5d596c00c6a18c7",
