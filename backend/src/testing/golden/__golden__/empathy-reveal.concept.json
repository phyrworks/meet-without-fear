      },
      "<message:ada@main#11>": {
        "content": "I think they're stressed from work too.",
        "content_hash": "b19cadf9c4e0e827c4fdded57d1de577cfe80a6d55849f48853b43b6ad9e7c01",
        "conversation_id": "<conversation:ada@main/MAIN>",
