      "<message:bob@main#6>": {
        "content": "I work so hard and come home exhausted, but there's always more to do.",
        "content_hash": "639fa2ff2151692748b916f4110d6d77b3bb45c37adeed1250c9c0c9b3c1bc02",
        "conversation_id": "<conversation:bob@main/MAIN>",
