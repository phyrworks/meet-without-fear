        "id": "<message:ada@main#12>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "AI",
        "sender_participant_id": null,
        "source_attempt_id": null
      },
      "<message:ada@main#1>": {
        "content": "Hi, I'm having issues with my partner.",
        "content_hash": "c2583ea77715a9728ceb23a629360518ceb88e42b7896478df7c6467b3492d93",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:1>",
        "id": "<message:ada@main#1>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "USER",
        "sender_participant_id": "<participant:ada@main>",
        "source_attempt_id": null
      },
      "<message:ada@main#2>": {
        "content": "I'm glad you reached out. Tell me more about what's happening.",
        "content_hash": "ab1e7653e34ae3e1c98dbe54ef23095167b7ecb913cd602ceea723a176e45d62",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:2>",
        "id": "<message:ada@main#2>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "AI",
        "sender_participant_id": null,
        "source_attempt_id": null
      },
      "<message:ada@main#3>": {
        "content": "We argue about household chores constantly.",
        "content_hash": "f88806d71a0080462eaa9f35ff80a8794c16e9093f2ec0667ee9bea5c647274f",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:3>",
        "id": "<message:ada@main#3>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "USER",
        "sender_participant_id": "<participant:ada@main>",
        "source_attempt_id": null
      },
      "<message:ada@main#4>": {
        "content": "That sounds frustrating. Would you like to invite your partner?",
        "content_hash": "6aac9315f8fc7f4649bb48456ac17778b1b968b179990b70b8bb5113b60eda17",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:4>",
        "id": "<message:ada@main#4>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "AI",
        "sender_participant_id": null,
        "source_attempt_id": null
      },
      "<message:ada@main#5>": {
        "content": "Yes, I sent the invitation.",
        "content_hash": "8b5f1f1770f6051fbdea485234c21e8b79a94d09c354aefb3f3373678f6b36d5",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:5>",
        "id": "<message:ada@main#5>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "USER",
        "sender_participant_id": "<participant:ada@main>",
        "source_attempt_id": null
      },
      "<message:ada@main#6>": {
        "content": "Great. Let's continue exploring your perspective while we wait.",
        "content_hash": "d80b6b56e31303bc11c83773f3ed4800a772b91a9e3fd38f0a8db901cb88a8fa",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:6>",
        "id": "<message:ada@main#6>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "AI",
        "sender_participant_id": null,
        "source_attempt_id": null
      },
      "<message:ada@main#7>": {
        "content": "I feel like I do most of the work and they don't notice.",
        "content_hash": "b07b70a89b858e52ec6b17ff6ae02332d8786c48e133cd6601ba546cb8ecd297",
        "conversation_id": "<conversation:ada@main/MAIN>",
        "created_at": "<ts:7>",
        "id": "<message:ada@main#7>",
        "kind": "CHAT",
        "refining_need_id": null,
        "role": "USER",
        "sender_participant_id": "<participant:ada@main>",
        "source_attempt_id": null
      },
      "<message:ada@main#8>": {
        "content": "I hear you. Do you feel like I understand what you've been experiencing?",
        "content_hash": "f6b8797d1050971693ec9c343edb3f34fd0c2f6267ee974aed829c2b5f1fe3fc",
        "conversation_id": "<conversation:ada@main/MAIN>",
