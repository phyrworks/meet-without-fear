      },
      "<message:bob@main#5>": {
        "content": "That sounds really hard. Can you tell me more?",
        "content_hash": "7dcfa44de7b3290ba953cf2f9ee409039675d9550bea2cf9cf658acb8ca23869",
        "conversation_id": "<conversation:bob@main/MAIN>",
