exports[`mwf_app grants (target) the app_access (mwf_app) privilege matrix is exactly the recorded one 1`] = `
"column public.ai_memory INSERT: user_id, kind, doc, doc_schema_version, created_at, updated_at (app_access)
column public.ai_memory UPDATE: doc, updated_at (app_access)
column public.consent INSERT: session_id, user_id, requested_by_user_id, need_id, empathy_attempt_id, share_offer_id, review_id, decision, decided_at, created_at, updated_at (app_access)
column public.consent UPDATE: decision, decided_at, revoked_at, updated_at (app_access)
column public.context_share_offer UPDATE: status, suggested_content, shared_content, shared_at, declined_at, offered_at, updated_at (app_access)
column public.conversation INSERT: session_id, user_id, kind, anchor_kind, anchor_proposal_id, status, next_seq, created_at, updated_at (app_access)
column public.conversation UPDATE: status, resolved_at, updated_at (app_access)
column public.conversation_read_state INSERT: session_id, user_id, last_viewed_at, last_seen_conversation_id, last_seen_seq, last_viewed_share_tab_at, last_active_at, created_at, updated_at (app_access)
column public.conversation_read_state UPDATE: last_viewed_at, last_seen_conversation_id, last_seen_seq, last_viewed_share_tab_at, last_active_at, updated_at (app_access)
column public.draft INSERT: session_id, user_id, kind, about_user_id, attempt_id, share_offer_id, invitation_id, content, ready_to_share, version, reopened_at (app_access)
column public.draft UPDATE: content, ready_to_share, version, reopened_at (app_access)
column public.empathy_attempt INSERT: session_id, author_user_id, subject_user_id, round, content, status, status_version, submitted_at, delivery_status, created_at, updated_at (app_access)
column public.empathy_review INSERT: attempt_id, session_id, reviewer_user_id, validated, feedback, feedback_sent_at, created_at, updated_at (app_access)
column public.empathy_review UPDATE: validated, feedback, feedback_sent_at, updated_at (app_access)
column public.feature_state INSERT: user_id, feature, doc (app_access)
