{
  "//": "TS-9 file-scoped type check (phoenix/target-shape; REMOVE at TS-13 with the target jest config). The files of the rewritten cluster and their tests; errors are read for these files only (imports pull in clusters not yet rewritten). Run: npx tsc --noEmit -p tsconfig.ts9.json",
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "src/types/**/*",
    "src/lib/prisma.ts",
    "src/lib/request-context.ts",
    "src/middleware/auth.ts",
    "src/services/participant-resolver.ts",
    "src/services/stage-shim.ts",
    "src/services/message-store.ts",
    "src/services/milestone-writer.ts",
    "src/services/context-assembler.ts",
    "src/services/shared-context.ts",
    "src/services/stream-turn-admission.ts",
    "src/services/stream-turn-persistence.ts",
    "src/services/stream-turn-background.ts",
    "src/services/context-retriever.ts",
    "src/controllers/session-state.ts",
    "src/controllers/messages.ts",
    "src/controllers/stage0.ts",
    "src/utils/session.ts",
    "src/utils/stage-resolver.ts",
    "src/testing/state-factory.ts",
    "src/testing/fixture-scenarios/target-shape.ts",
    "src/testing/golden/**/*.ts",
    "src/services/__tests__/stage-shim.test.ts",
    "src/services/__tests__/message-store.test.ts",
    "src/services/__tests__/participant-context.target.test.ts",
    "src/testing/fixture-scenarios/__tests__/target-shape.test.ts",
    "../shared/src/*.ts",
    "../shared/src/contracts/*.ts",
    "../shared/src/dto/**/*.ts",
    "../shared/src/validation/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
