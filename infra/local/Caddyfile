# Local replica: one origin for the web app and the API (infra/local/compose.yaml
# publishes it on 127.0.0.1 only). The API part matches infra/aws/Caddyfile's
# :8080 block; the static part stands in for the hosted web app.
{
	admin off
	auto_https off
}

:8080 {
	@api path /api /api/* /health /realtime /realtime/*
	handle @api {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
